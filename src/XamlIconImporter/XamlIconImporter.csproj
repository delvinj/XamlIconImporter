<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xaml-icon-importer</ToolCommandName>
    <PackageId>XamlIconImporter</PackageId>
    <Version>1.0.0</Version>
    <Authors>XamlIconImporter</Authors>
    <Description>Imports standalone WPF vector XAML files into ResourceDictionary files.</Description>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>
</Project>
